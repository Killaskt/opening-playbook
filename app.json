{
  "expo": {
    "name": "Opening Playbook",
    "slug": "opening-playbook",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.killaskt.openingplaybook",
      "buildNumber": "1",
"infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.killaskt.openingplaybook"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router"
    ],
    "extra": {
      "privacyPolicyUrl": "https://github.com/Killaskt/opening-playbook-legal",
      "router": {},
      "eas": {
        "projectId": "72dc9612-188b-4599-a2a8-03bfbd659797"
      }
    }
  }
}
